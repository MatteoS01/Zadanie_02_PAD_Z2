
<Window x:Class="PAD_Z2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PAD – Zadanie 2"
        Height="580" Width="850"
        MinHeight="400" MinWidth="500">


    <Window.Resources>

    
        <Style TargetType="Button">

         
            <Setter Property="BorderThickness" Value="5"/>

          
            <Setter Property="Margin" Value="3"/>

           
            <Setter Property="Padding" Value="10,5"/>

           
            <Setter Property="BorderBrush" Value="#2980B9"/>

        
            <Setter Property="Background" Value="#D6EAF8"/>

           
            <Setter Property="Foreground" Value="#1A3A5C"/>

            <Setter Property="FontSize" Value="13"/>


            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

             
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">


                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}"/>

                        </Border>


                        <ControlTemplate.Triggers>


                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Background" Value="#85C1E9"/>

                                <Setter TargetName="bd" Property="BorderBrush" Value="#154360"/>

                                <Setter TargetName="bd" Property="TextBlock.Foreground" Value="#FFFFFF"/>
                            </Trigger>


                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E86C1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1A5276"/>
                                <Setter TargetName="bd" Property="TextBlock.Foreground" Value="#FDFEFE"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="AlternativeButtonStyle" TargetType="Button">

            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="Background" Value="#FDEDEC"/>
            <Setter Property="Foreground" Value="#7B241C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1948A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#922B21"/>

                                <Setter TargetName="bd" Property="TextBlock.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C0392B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7B241C"/>
                                <Setter TargetName="bd" Property="TextBlock.Foreground" Value="#FDFEFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0"
                Background="#EAF2F8"
                BorderBrush="#AED6F1"
                BorderThickness="0,0,0,2"
                Padding="5,4">
            <StackPanel Orientation="Horizontal">


                <Button Content="Plik"/>
                <Button Content="Edycja"/>
                <Button Content="Widok"/>
                <Button Content="Pomoc"/>


                <Button Content="⚙ Opcje"
                        Style="{StaticResource AlternativeButtonStyle}"/>

            </StackPanel>
        </Border>


        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="BorderThickness" Value="5"/>
                    <Setter Property="Margin" Value="3"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="BorderBrush" Value="#27AE60"/>
                    <Setter Property="Background" Value="#E9F7EF"/>
                    <Setter Property="Foreground" Value="#1D5E2E"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#A9DFBF"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#1E8449"/>
                                        <Setter TargetName="bd" Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1E8449"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#145A32"/>
                                        <Setter TargetName="bd" Property="TextBlock.Foreground" Value="#FDFEFE"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>


            <Border Grid.Row="0" Grid.Column="0"
                    Background="#EBF5EB"
                    BorderBrush="#A9DFBF"
                    BorderThickness="0,0,2,0"
                    Padding="5,8">
                <StackPanel Orientation="Vertical">


                    <Button Content="Panel"/>
                    <Button Content="Narzędzia"/>
                    <Button Content="Historia"/>
                    <Button Content="Zakładki"/>

                    <Button Content="⚠ Usuń"
                            Style="{StaticResource AlternativeButtonStyle}"/>

                </StackPanel>
            </Border>


            <Grid Grid.Row="0" Grid.Column="1" Background="#FDFEFE" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        BorderBrush="#E5E5E5" BorderThickness="0,0,1,1"
                        Background="#FAFAFA"/>
                <Border Grid.Row="0" Grid.Column="1"
                        BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
                        Background="#FAFAFA"/>
                <Border Grid.Row="1" Grid.Column="0"
                        BorderBrush="#E5E5E5" BorderThickness="0,0,1,1"
                        Background="#F5F5F5"/>
                <Border Grid.Row="1" Grid.Column="1"
                        BorderBrush="#E5E5E5" BorderThickness="0,0,0,1"
                        Background="#F5F5F5"/>
                <Border Grid.Row="2" Grid.Column="0"
                        BorderBrush="#E5E5E5" BorderThickness="0,0,1,0"
                        Background="#FAFAFA"/>
                <Border Grid.Row="2" Grid.Column="1"
                        BorderBrush="#E5E5E5" BorderThickness="0,0,0,0"
                        Background="#FAFAFA"/>
            </Grid>

            <Border Grid.Row="1" Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="#EBF5EB"
                    BorderBrush="#A9DFBF"
                    BorderThickness="0,2,0,0"
                    Padding="5,4">
                <StackPanel Orientation="Horizontal">


                    <Button Content="Zapisz"/>
                    <Button Content="Otwórz"/>
                    <Button Content="Drukuj"/>


                    <Button Content="✖ Zamknij"
                            Style="{StaticResource AlternativeButtonStyle}"/>

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
